{
  "name": "scheduler_smoke",
  "description": "Small real-GPU scheduler scenario used to verify flexible case expansion.",
  "output_root": "debug_runs/scheduler_scenarios/smoke",
  "target_stage": 2,
  "seeds": [20260531],
  "defaults": {
    "model_name": "tinyllama",
    "manifest": "data/sft_requests/tinyllama_agnews128_label_train512_seed20260531/requests.jsonl",
    "eval_manifest": "data/sft_requests/tinyllama_agnews128_label_eval256_seed20260531/requests.jsonl",
    "num_chunks": 3,
    "stage_devices": ["cuda:0", "cuda:1", "cuda:2"],
    "topology": "phone_fixed",
    "target_stage": 2,
    "train_limit": 32,
    "eval_limit": 64,
    "max_inflight": 8,
    "scheduler_policy": "fifo",
    "recovery_policy": "replay_after_update",
    "belief_transport_mode": "terminal",
    "dtype": "bfloat16",
    "train_chunks": "all",
    "progress_interval": 0
  },
  "cases": [
    {
      "name": "all_updates"
    }
  ],
  "sweeps": [
    {
      "name": "queue_thresholds",
      "name_template": "queue{threshold}",
      "axes": {
        "threshold": [0]
      },
      "overrides": {
        "stage_update_policy": "queue_gated",
        "stage_update_queue_thresholds": {
          "{target_stage}": "{threshold}"
        }
      }
    }
  ]
}
