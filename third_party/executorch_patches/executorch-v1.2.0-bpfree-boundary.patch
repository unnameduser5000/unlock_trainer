+package org.pytorch.executorch.training;
+
+import android.util.Log;
+import com.facebook.jni.HybridData;
+import com.facebook.jni.annotations.DoNotStrip;
+import com.facebook.soloader.nativeloader.NativeLoader;
+import com.facebook.soloader.nativeloader.SystemDelegate;
+import java.util.HashMap;
+import java.util.Map;
+import org.pytorch.executorch.EValue;
+import org.pytorch.executorch.ExecuTorchRuntime;
+import org.pytorch.executorch.Tensor;
+import org.pytorch.executorch.annotations.Experimental;
+
+/** Runs a BP-free joint training graph in forward-boundary and backward phases. */
+@Experimental
+public final class BPFreeTrainingModule implements AutoCloseable {
+
+  static {
+    if (!NativeLoader.isInitialized()) {
+      NativeLoader.init(new SystemDelegate());
+    }
+    NativeLoader.loadLibrary("executorch");
+  }
+
+  /** Boundary values are copied by native code and remain valid during backward. */
+  public static final class BoundaryResult {
+    public final Tensor loss;
+    public final Tensor hidden;
+    public final Tensor belief;
+
+    private BoundaryResult(EValue[] outputs) {
+      if (outputs.length != 3) {
+        throw new IllegalStateException(
+            "Expected loss, hidden, and belief at the BP-free boundary; got " + outputs.length);
+      }
+      loss = outputs[0].toTensor();
+      hidden = outputs[1].toTensor();
+      belief = outputs[2].toTensor();
+    }
+  }
+
+  private final HybridData mHybridData;
+
+  @DoNotStrip
+  private static native HybridData initHybrid(String moduleAbsolutePath, String dataAbsolutePath);
+
+  private BPFreeTrainingModule(String moduleAbsolutePath, String dataAbsolutePath) {
+    mHybridData = initHybrid(moduleAbsolutePath, dataAbsolutePath);
+  }
+
+  public static BPFreeTrainingModule load(final String modelPath) {
+    ExecuTorchRuntime.validateFilePath(modelPath, "model path");
+    return new BPFreeTrainingModule(modelPath, "");
+  }
+
+  public static BPFreeTrainingModule load(final String modelPath, final String dataPath) {
+    ExecuTorchRuntime.validateFilePath(modelPath, "model path");
+    ExecuTorchRuntime.validateFilePath(dataPath, "data path");
+    return new BPFreeTrainingModule(modelPath, dataPath);
+  }
+
+  /** Executes through the boundary marker and leaves this module paused. */
+  public BoundaryResult forwardToBoundary(String methodName, EValue... inputs) {
+    ensureValid();
+    return new BoundaryResult(forwardToBoundaryNative(methodName, inputs));
+  }
+
+  /** Resumes the paused Method through backward and returns its user outputs. */
+  public EValue[] resumeBackward(String methodName) {
+    ensureValid();
+    return resumeBackwardNative(methodName);
+  }
+
+  public Map<String, Tensor> namedParameters(String methodName) {
+    if (!mHybridData.isValid()) {
+      Log.e("ExecuTorch", "Attempt to use a destroyed BP-free training module");
+      return new HashMap<>();
+    }
+    return namedParametersNative(methodName);
+  }
+
+  public Map<String, Tensor> namedGradients(String methodName) {
+    if (!mHybridData.isValid()) {
+      Log.e("ExecuTorch", "Attempt to use a destroyed BP-free training module");
+      return new HashMap<>();
+    }
+    return namedGradientsNative(methodName);
+  }
+
+  /** Releases the native module and any paused Method state. */
+  public void destroy() {
+    if (mHybridData.isValid()) {
+      mHybridData.resetNative();
+    }
+  }
+
+  @Override
+  public void close() {
+    destroy();
+  }
+
+  private void ensureValid() {
+    if (!mHybridData.isValid()) {
+      throw new IllegalStateException("Attempt to use a destroyed BP-free training module");
+    }
+  }
+
+  @DoNotStrip
+  private native EValue[] forwardToBoundaryNative(String methodName, EValue... inputs);
+
+  @DoNotStrip
+  private native EValue[] resumeBackwardNative(String methodName);
+
+  @DoNotStrip
+  private native Map<String, Tensor> namedParametersNative(String methodName);
+
+  @DoNotStrip
+  private native Map<String, Tensor> namedGradientsNative(String methodName);
+}
