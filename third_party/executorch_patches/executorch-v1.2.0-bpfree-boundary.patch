+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include <executorch/extension/tensor/tensor.h>
+#include <executorch/runtime/core/error.h>
+
+namespace executorch::extension::training::bpfree {
+
+struct TensorCapture {
+  std::vector<uint8_t> bytes;
+  std::vector<executorch::aten::SizesType> sizes;
+  executorch::aten::ScalarType scalar_type{
+      executorch::aten::ScalarType::Undefined};
+
+  TensorPtr into_tensor_ptr();
+};
+
+struct BoundaryCapture {
+  bool reached{false};
+  TensorCapture loss;
+  TensorCapture hidden;
+  TensorCapture belief;
+};
+
+void set_active_boundary_capture(BoundaryCapture* capture);
+
+runtime::Error register_pipeline_boundary_operator();
+
+} // namespace executorch::extension::training::bpfree
diff --git a/extension/training/module/bpfree_pipeline_boundary.cpp b/extension/training/module/bpfree_pipeline_boundary.cpp
new file mode 100644
index 0000000..bdc747a
--- /dev/null
+++ b/extension/training/module/bpfree_pipeline_boundary.cpp
@@ -0,0 +1,86 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * All rights reserved.
+ *
+ * This source code is licensed under the BSD-style license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#include <executorch/extension/training/module/bpfree_pipeline_boundary.h>
+
+#include <cstring>
+
+#include <executorch/runtime/kernel/kernel_includes.h>
+#include <executorch/runtime/kernel/operator_registry.h>
+
+namespace executorch::extension::training::bpfree {
+namespace {
+
+constexpr const char* kBoundaryOperator =
+    "sid_bpfree_pipeline::pipeline_boundary.out";
+thread_local BoundaryCapture* active_capture = nullptr;
+
+void capture_tensor(const executorch::aten::Tensor& tensor, TensorCapture& out) {
+  out.bytes.resize(tensor.nbytes());
+  if (!out.bytes.empty()) {
+    std::memcpy(out.bytes.data(), tensor.const_data_ptr(), tensor.nbytes());
+  }
+  out.sizes.assign(tensor.sizes().begin(), tensor.sizes().end());
+  out.scalar_type = tensor.scalar_type();
+}
+
+void pipeline_boundary(
+    runtime::KernelRuntimeContext& context,
+    runtime::Span<runtime::EValue*> stack) {
+  ET_KERNEL_CHECK_MSG(
+      context,
+      stack.size() == 5,
+      InvalidProgram,
+      /* void */,
+      // ExecuTorch's boxed .out convention appends a return slot after the
+      // four schema arguments. This matches its generated wrapper exactly.
+      "Expected five boxed boundary slots, got %zu",
+      stack.size());
+
+  const auto& loss = stack[0]->toTensor();
+  const auto& hidden = stack[1]->toTensor();
+  const auto& belief = stack[2]->toTensor();
+  auto& out = stack[3]->toTensor();
+  ET_KERNEL_CHECK_MSG(
+      context,
+      loss.scalar_type() == executorch::aten::ScalarType::Float &&
+          out.scalar_type() == loss.scalar_type() &&
+          out.nbytes() == loss.nbytes(),
+      InvalidArgument,
+      /* void */,
+      "Boundary loss/output metadata mismatch");
+
+  std::memcpy(out.mutable_data_ptr(), loss.const_data_ptr(), loss.nbytes());
+  if (active_capture != nullptr) {
+    capture_tensor(loss, active_capture->loss);
+    capture_tensor(hidden, active_capture->hidden);
+    capture_tensor(belief, active_capture->belief);
+    active_capture->reached = true;
+  }
+}
+
+} // namespace
+
+TensorPtr TensorCapture::into_tensor_ptr() {
+  return make_tensor_ptr(
+      std::move(sizes), std::move(bytes), scalar_type);
+}
+
+void set_active_boundary_capture(BoundaryCapture* capture) {
+  active_capture = capture;
+}
+
+runtime::Error register_pipeline_boundary_operator() {
+  if (runtime::registry_has_op_function(kBoundaryOperator)) {
+    return runtime::Error::Ok;
+  }
+  static const runtime::Kernel kernel(kBoundaryOperator, pipeline_boundary);
+  return runtime::register_kernel(kernel);
+}
+
+} // namespace executorch::extension::training::bpfree
diff --git a/extension/training/module/bpfree_training_module.h b/extension/training/module/bpfree_training_module.h
