+
+#include <executorch/extension/android/jni/jni_layer_constants.h>
+#include <executorch/extension/data_loader/file_data_loader.h>
+#include <executorch/extension/tensor/tensor.h>
+#include <executorch/extension/training/module/bpfree_pipeline_boundary.h>
+#include <executorch/extension/training/module/bpfree_training_module.h>
+#include <executorch/runtime/platform/log.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <fbjni/fbjni.h>
+
+namespace executorch::extension {
+
+class TensorHybrid : public facebook::jni::HybridClass<TensorHybrid> {
+ public:
+  constexpr static const char* kJavaDescriptor =
+      "Lorg/pytorch/executorch/Tensor;";
+
+  static facebook::jni::local_ref<TensorHybrid::javaobject>
+  newJTensorFromTensor(const executorch::aten::Tensor& tensor);
+
+  static TensorPtr newTensorFromJTensor(
+      facebook::jni::alias_ref<TensorHybrid::javaobject> jtensor);
+};
+
+class JEValue : public facebook::jni::JavaClass<JEValue> {
+ public:
+  constexpr static const char* kJavaDescriptor =
+      "Lorg/pytorch/executorch/EValue;";
+
+  constexpr static int kTypeCodeTensor = 1;
+  constexpr static int kTypeCodeDouble = 3;
+  constexpr static int kTypeCodeInt = 4;
+  constexpr static int kTypeCodeBool = 5;
+
+  static facebook::jni::local_ref<JEValue> newJEValueFromEValue(
+      runtime::EValue evalue);
+
+  static TensorPtr JEValueToTensorImpl(
+      facebook::jni::alias_ref<JEValue> jevalue);
+};
+
+class BPFreeTrainingJni
+    : public facebook::jni::HybridClass<BPFreeTrainingJni> {
+ public:
+  constexpr static const char* kJavaDescriptor =
+      "Lorg/pytorch/executorch/training/BPFreeTrainingModule;";
+
+  BPFreeTrainingJni(
+      facebook::jni::alias_ref<jstring> model_path,
+      facebook::jni::alias_ref<jstring> data_path) {
+    auto model_result = FileDataLoader::from(model_path->toStdString().c_str());
+    if (!model_result.ok()) {
+      facebook::jni::throwNewJavaException(
+          "java/lang/Exception", "Failed to open BP-free model file");
+    }
+    auto model_loader =
+        std::make_unique<FileDataLoader>(std::move(model_result.get()));
+
+    std::unique_ptr<FileDataLoader> data_loader;
+    const auto data_path_string = data_path->toStdString();
+    if (!data_path_string.empty()) {
+      auto data_result = FileDataLoader::from(data_path_string.c_str());
+      if (!data_result.ok()) {
+        facebook::jni::throwNewJavaException(
+            "java/lang/Exception", "Failed to open BP-free data file");
+      }
+      data_loader =
+          std::make_unique<FileDataLoader>(std::move(data_result.get()));
+    }
+
+    module_ = std::make_unique<training::BPFreeTrainingModule>(
+        std::move(model_loader),
+        nullptr,
+        nullptr,
+        nullptr,
+        std::move(data_loader));
+  }
+
+  static facebook::jni::local_ref<jhybriddata> initHybrid(
+      facebook::jni::alias_ref<jclass>,
+      facebook::jni::alias_ref<jstring> model_path,
+      facebook::jni::alias_ref<jstring> data_path) {
+    return makeCxxInstance(model_path, data_path);
+  }
+
+  facebook::jni::local_ref<facebook::jni::JArrayClass<JEValue>>
+  forwardToBoundary(
+      facebook::jni::alias_ref<jstring> method_name,
+      facebook::jni::alias_ref<
+          facebook::jni::JArrayClass<JEValue::javaobject>::javaobject>
+          inputs) {
+    if (module_->is_paused()) {
+      facebook::jni::throwNewJavaException(
+          "java/lang/IllegalStateException",
+          "BP-free module is already paused at a boundary");
+    }
+    auto evalues = convertInputs(inputs);
+    auto result =
+        module_->forward_to_boundary(method_name->toStdString(), evalues);
+    if (!result.ok()) {
+      input_tensor_keepalives_.clear();
+      throwExecutionError("forward-to-boundary", result.error());
+    }
+    return toJavaArray(result.get());
+  }
+
+  facebook::jni::local_ref<facebook::jni::JArrayClass<JEValue>>
+  resumeBackward(facebook::jni::alias_ref<jstring> method_name) {
+    auto result = module_->resume_backward(method_name->toStdString());
+    input_tensor_keepalives_.clear();
+    if (!result.ok()) {
+      throwExecutionError("backward-resume", result.error());
+    }
+    return toJavaArray(result.get());
+  }
+
+  facebook::jni::local_ref<
+      facebook::jni::JMap<jstring, TensorHybrid::javaobject>>
+  namedParameters(facebook::jni::alias_ref<jstring> method_name) {
+    return namedTensors(
+        module_->named_parameters(method_name->toStdString()), "parameters");
+  }
+
+  facebook::jni::local_ref<
+      facebook::jni::JMap<jstring, TensorHybrid::javaobject>>
+  namedGradients(facebook::jni::alias_ref<jstring> method_name) {
+    return namedTensors(
+        module_->named_gradients(method_name->toStdString()), "gradients");
+  }
+
+  static void registerNatives() {
+    registerHybrid({
+        makeNativeMethod("initHybrid", BPFreeTrainingJni::initHybrid),
+        makeNativeMethod(
+            "forwardToBoundaryNative", BPFreeTrainingJni::forwardToBoundary),
+        makeNativeMethod(
+            "resumeBackwardNative", BPFreeTrainingJni::resumeBackward),
+        makeNativeMethod(
+            "namedParametersNative", BPFreeTrainingJni::namedParameters),
+        makeNativeMethod(
+            "namedGradientsNative", BPFreeTrainingJni::namedGradients),
+    });
+  }
+
+ private:
+  friend HybridBase;
+
+  std::vector<runtime::EValue> convertInputs(
+      facebook::jni::alias_ref<
+          facebook::jni::JArrayClass<JEValue::javaobject>::javaobject>
+          inputs) {
+    input_tensor_keepalives_.clear();
+    std::vector<runtime::EValue> evalues;
+    evalues.reserve(inputs->size());
+    static const auto type_code_field =
+        JEValue::javaClassStatic()->getField<jint>("mTypeCode");
+
+    for (int index = 0; index < inputs->size(); ++index) {
+      auto value = inputs->getElement(index);
+      const auto type_code = value->getFieldValue(type_code_field);
+      if (type_code == JEValue::kTypeCodeTensor) {
+        input_tensor_keepalives_.push_back(
+            JEValue::JEValueToTensorImpl(value));
+        evalues.emplace_back(*input_tensor_keepalives_.back());
+      } else if (type_code == JEValue::kTypeCodeInt) {
+        static const auto method =
+            JEValue::javaClassStatic()->getMethod<jlong()>("toInt");
+        evalues.emplace_back(static_cast<int64_t>(method(value)));
+      } else if (type_code == JEValue::kTypeCodeDouble) {
+        static const auto method =
+            JEValue::javaClassStatic()->getMethod<jdouble()>("toDouble");
+        evalues.emplace_back(static_cast<double>(method(value)));
+      } else if (type_code == JEValue::kTypeCodeBool) {
+        static const auto method =
+            JEValue::javaClassStatic()->getMethod<jboolean()>("toBool");
+        evalues.emplace_back(static_cast<bool>(method(value)));
+      } else {
+        facebook::jni::throwNewJavaException(
+            "java/lang/IllegalArgumentException",
+            "Unsupported BP-free input EValue type");
+      }
+    }
+    return evalues;
+  }
+
+  static facebook::jni::local_ref<facebook::jni::JArrayClass<JEValue>>
+  toJavaArray(const std::vector<runtime::EValue>& values) {
+    auto result = facebook::jni::JArrayClass<JEValue>::newArray(values.size());
+    for (size_t index = 0; index < values.size(); ++index) {
+      result->setElement(
+          index, *JEValue::newJEValueFromEValue(values.at(index)));
+    }
+    return result;
+  }
+
+  static facebook::jni::local_ref<
+      facebook::jni::JMap<jstring, TensorHybrid::javaobject>>
+  namedTensors(
+      const runtime::Result<
+          const std::map<std::string_view, executorch::aten::Tensor>>& result,
+      const char* kind) {
+    if (!result.ok()) {
+      throwExecutionError(kind, result.error());
+    }
+    auto tensors = facebook::jni::
+        JHashMap<jstring, TensorHybrid::javaobject>::create();
+    for (const auto& [name, tensor] : result.get()) {
+      tensors->put(
+          facebook::jni::make_jstring(name.data()),
+          TensorHybrid::newJTensorFromTensor(tensor));
+    }
+    return tensors;
+  }
+
+  static void throwExecutionError(const char* operation, runtime::Error error) {
+    facebook::jni::throwNewJavaException(
+        "java/lang/Exception",
+        "BP-free %s failed with status 0x%" PRIx32,
+        operation,
+        static_cast<runtime::error_code_t>(error));
+  }
+
+  std::unique_ptr<training::BPFreeTrainingModule> module_;
+  // Method inputs may be read during backward, after the first JNI call returns.
+  std::vector<TensorPtr> input_tensor_keepalives_;
+};
+
+} // namespace executorch::extension
+
+void register_natives_for_bpfree_training() {
+  const auto registration = executorch::extension::training::bpfree::
+      register_pipeline_boundary_operator();
+  if (registration != executorch::runtime::Error::Ok) {
+    ET_LOG(
+        Error,
+        "Failed to register the BP-free pipeline boundary operator: 0x%" PRIx32,
+        static_cast<executorch::runtime::error_code_t>(registration));
+  }
+  executorch::extension::BPFreeTrainingJni::registerNatives();
+}
