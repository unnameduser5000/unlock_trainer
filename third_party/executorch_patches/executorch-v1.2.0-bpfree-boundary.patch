+++ b/extension/training/module/bpfree_training_module.h
@@ -0,0 +1,90 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * All rights reserved.
+ *
+ * This source code is licensed under the BSD-style license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#pragma once
+
+#include <map>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <executorch/extension/module/module.h>
+#include <executorch/extension/tensor/tensor.h>
+#include <executorch/runtime/core/evalue.h>
+
+namespace executorch::extension::training {
+
+/**
+ * Executes one joint training Method in two phases around a BP-free boundary.
+ *
+ * Only one Method may be paused at a time. This preserves the normal Module
+ * memory plan and intentionally does not create a pool of training sessions.
+ */
+class ET_EXPERIMENTAL BPFreeTrainingModule final
+    : public executorch::extension::Module {
+ public:
+  explicit BPFreeTrainingModule(
+      std::unique_ptr<runtime::DataLoader> data_loader,
+      std::unique_ptr<runtime::MemoryAllocator> memory_allocator = nullptr,
+      std::unique_ptr<runtime::MemoryAllocator> temp_allocator = nullptr,
+      std::unique_ptr<runtime::EventTracer> event_tracer = nullptr,
+      std::unique_ptr<runtime::DataLoader> data_map_data_loader = nullptr)
+      : executorch::extension::Module(
+            std::move(data_loader),
+            std::move(memory_allocator),
+            std::move(temp_allocator),
+            std::move(event_tracer),
+            std::move(data_map_data_loader)) {}
+
+  runtime::Result<std::vector<runtime::EValue>> forward_to_boundary(
+      const std::string& method_name,
+      const std::vector<runtime::EValue>& input);
+
+  runtime::Result<std::vector<runtime::EValue>> resume_backward(
+      const std::string& method_name);
+
+  runtime::Result<
+      const std::map<std::string_view, executorch::aten::Tensor>>
+  named_parameters(const std::string& method_name);
+
+  runtime::Result<
+      const std::map<std::string_view, executorch::aten::Tensor>>
+  named_gradients(const std::string& method_name);
+
+  bool is_paused() const {
+    return !paused_method_.empty();
+  }
+
+ private:
+  struct OutputLayout {
+    size_t gradient_start;
+    size_t parameter_start;
+  };
+
+  runtime::Result<OutputLayout> output_layout(
+      const std::string& method_name);
+  runtime::Error populate_gradients(
+      const std::string& method_name,
+      const OutputLayout& layout);
+  void discard_method(const std::string& method_name);
+
+  std::string paused_method_;
+  OutputLayout paused_layout_{0, 0};
+  std::vector<TensorPtr> boundary_tensors_;
+  std::unordered_map<
+      std::string,
+      std::map<std::string_view, executorch::aten::Tensor>>
+      method_named_gradients_;
+  std::unordered_map<
+      std::string,
+      std::map<std::string_view, executorch::aten::Tensor>>
+      method_named_parameters_;
+};
+
+} // namespace executorch::extension::training
diff --git a/extension/training/module/bpfree_training_module.cpp b/extension/training/module/bpfree_training_module.cpp
new file mode 100644
index 0000000..5ae0f20
--- /dev/null
+++ b/extension/training/module/bpfree_training_module.cpp
@@ -0,0 +1,248 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * All rights reserved.
+ *
+ * This source code is licensed under the BSD-style license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#include <executorch/extension/training/module/bpfree_training_module.h>
+
+#include <executorch/extension/training/module/bpfree_pipeline_boundary.h>
+#include <executorch/runtime/platform/log.h>
+
+namespace executorch::extension::training {
+namespace {
+
+std::string parameters_index_method(const std::string& method_name) {
+  return "__et_training_parameters_index_" + method_name;
+}
+
+std::string gradients_index_method(const std::string& method_name) {
+  return "__et_training_gradients_index_" + method_name;
+}
+
+std::string fqn_method(const std::string& method_name) {
+  return "__et_training_fqn_" + method_name;
+}
+
+} // namespace
+
+runtime::Result<BPFreeTrainingModule::OutputLayout>
+BPFreeTrainingModule::output_layout(const std::string& method_name) {
+  auto gradient_result = Module::execute(gradients_index_method(method_name));
+  if (!gradient_result.ok()) {
+    return gradient_result.error();
+  }
+  auto parameter_result = Module::execute(parameters_index_method(method_name));
+  if (!parameter_result.ok()) {
+    return parameter_result.error();
+  }
+  return OutputLayout{
+      static_cast<size_t>(gradient_result->at(0).toInt()),
+      static_cast<size_t>(parameter_result->at(0).toInt())};
+}
+
+runtime::Result<std::vector<runtime::EValue>>
+BPFreeTrainingModule::forward_to_boundary(
+    const std::string& method_name,
+    const std::vector<runtime::EValue>& input) {
+  if (is_paused()) {
+    ET_LOG(Error, "Method %s is already paused", paused_method_.c_str());
+    return runtime::Error::InvalidState;
+  }
+  auto registration = bpfree::register_pipeline_boundary_operator();
+  if (registration != runtime::Error::Ok) {
+    return registration;
+  }
+  auto layout_result = output_layout(method_name);
+  if (!layout_result.ok()) {
+    return layout_result.error();
+  }
+  auto load_error = load_method(method_name);
+  if (load_error != runtime::Error::Ok) {
+    return load_error;
+  }
+
+  auto& method = methods_.at(method_name).method;
+  const executorch::aten::ArrayRef<runtime::EValue> input_ref(
+      input.data(), input.size());
+  auto input_error = method->set_inputs(input_ref);
+  if (input_error != runtime::Error::Ok) {
+    return input_error;
+  }
+
+  bpfree::BoundaryCapture capture;
+  bpfree::set_active_boundary_capture(&capture);
+  while (!capture.reached) {
+    auto step_error = method->step();
+    if (step_error != runtime::Error::Ok) {
+      bpfree::set_active_boundary_capture(nullptr);
+      if (step_error == runtime::Error::EndOfMethod) {
+        const auto reset_error = method->reset_execution();
+        if (reset_error != runtime::Error::Ok) {
+          discard_method(method_name);
+          return reset_error;
+        }
+        return runtime::Error::InvalidProgram;
+      }
+      discard_method(method_name);
+      return step_error;
+    }
+  }
+  bpfree::set_active_boundary_capture(nullptr);
+
+  if (!method->in_progress()) {
+    const auto reset_error = method->reset_execution();
+    if (reset_error != runtime::Error::Ok) {
+      discard_method(method_name);
+      return reset_error;
+    }
+    return runtime::Error::InvalidState;
+  }
+
+  boundary_tensors_.clear();
+  boundary_tensors_.push_back(capture.loss.into_tensor_ptr());
+  boundary_tensors_.push_back(capture.hidden.into_tensor_ptr());
+  boundary_tensors_.push_back(capture.belief.into_tensor_ptr());
+  paused_method_ = method_name;
+  paused_layout_ = layout_result.get();
+
+  std::vector<runtime::EValue> outputs;
+  outputs.reserve(boundary_tensors_.size());
+  for (const auto& tensor : boundary_tensors_) {
+    outputs.emplace_back(*tensor);
+  }
+  return outputs;
+}
+
+runtime::Result<std::vector<runtime::EValue>>
+BPFreeTrainingModule::resume_backward(const std::string& method_name) {
+  if (paused_method_ != method_name) {
+    ET_LOG(
+        Error,
+        "Cannot resume %s while paused method is %s",
+        method_name.c_str(),
+        paused_method_.c_str());
+    return runtime::Error::InvalidState;
+  }
+
+  auto& method = methods_.at(method_name).method;
+  while (true) {
+    auto step_error = method->step();
+    if (step_error == runtime::Error::EndOfMethod) {
+      break;
+    }
+    if (step_error != runtime::Error::Ok) {
+      discard_method(method_name);
+      return step_error;
+    }
+  }
+
+  std::vector<runtime::EValue> user_outputs;
+  user_outputs.reserve(paused_layout_.gradient_start);
+  for (size_t index = 0; index < paused_layout_.gradient_start; ++index) {
+    user_outputs.push_back(method->get_output(index));
+  }
+  auto gradient_error = populate_gradients(method_name, paused_layout_);
+  if (gradient_error != runtime::Error::Ok) {
+    discard_method(method_name);
+    return gradient_error;
+  }
+  auto reset_error = method->reset_execution();
+  if (reset_error != runtime::Error::Ok) {
+    discard_method(method_name);
+    return reset_error;
+  }
+
+  paused_method_.clear();
+  paused_layout_ = {0, 0};
+  return user_outputs;
+}
+
+runtime::Error BPFreeTrainingModule::populate_gradients(
+    const std::string& method_name,
+    const OutputLayout& layout) {
+  if (method_named_gradients_.count(method_name) != 0) {
+    return runtime::Error::Ok;
+  }
+  auto fqn_result = Module::execute(fqn_method(method_name));
+  if (!fqn_result.ok()) {
+    return fqn_result.error();
+  }
+
+  auto& gradients = method_named_gradients_[method_name];
+  auto& method = methods_.at(method_name).method;
+  size_t name_index = 0;
+  for (size_t output_index = layout.gradient_start;
+       output_index < layout.parameter_start;
+       ++output_index, ++name_index) {
+    const std::string_view name = fqn_result->at(name_index).toString();
+    gradients.insert({name, method->get_output(output_index).toTensor()});
+  }
+  return runtime::Error::Ok;
+}
+
+runtime::Result<
+    const std::map<std::string_view, executorch::aten::Tensor>>
+BPFreeTrainingModule::named_parameters(const std::string& method_name) {
+  if (is_paused()) {
+    return runtime::Error::InvalidState;
+  }
+  // Android restores checkpoints before the first forward, which loads the
+  // Method through named_parameters(). Register the custom op first.
+  auto registration = bpfree::register_pipeline_boundary_operator();
+  if (registration != runtime::Error::Ok) {
+    return registration;
+  }
+  if (method_named_parameters_.count(method_name) == 0) {
+    auto fqn_result = Module::execute(fqn_method(method_name));
+    if (!fqn_result.ok()) {
+      return fqn_result.error();
+    }
+    auto layout_result = output_layout(method_name);
+    if (!layout_result.ok()) {
+      return layout_result.error();
+    }
+    auto load_error = load_method(method_name);
+    if (load_error != runtime::Error::Ok) {
+      return load_error;
+    }
+
+    auto& parameters = method_named_parameters_[method_name];
+    auto& method = methods_.at(method_name).method;
+    size_t name_index = 0;
+    for (size_t output_index = layout_result->parameter_start;
+         output_index < method->outputs_size();
+         ++output_index, ++name_index) {
+      const std::string_view name = fqn_result->at(name_index).toString();
+      parameters.insert({name, method->get_output(output_index).toTensor()});
+    }
+  }
+  return method_named_parameters_.at(method_name);
+}
+
+runtime::Result<
+    const std::map<std::string_view, executorch::aten::Tensor>>
+BPFreeTrainingModule::named_gradients(const std::string& method_name) {
+  if (is_paused()) {
+    return runtime::Error::InvalidState;
+  }
+  const auto found = method_named_gradients_.find(method_name);
+  if (found == method_named_gradients_.end()) {
+    return runtime::Error::InvalidArgument;
+  }
+  return found->second;
+}
+
+void BPFreeTrainingModule::discard_method(const std::string& method_name) {
+  bpfree::set_active_boundary_capture(nullptr);
+  methods_.erase(method_name);
+  method_named_gradients_.erase(method_name);
+  method_named_parameters_.erase(method_name);
+  paused_method_.clear();
+  paused_layout_ = {0, 0};
+  boundary_tensors_.clear();
+}
+
+} // namespace executorch::extension::training
diff --git a/extension/android/jni/jni_layer_bpfree_training.cpp b/extension/android/jni/jni_layer_bpfree_training.cpp
